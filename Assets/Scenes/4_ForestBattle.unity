  enemyTextSpawn: {fileID: 374019970}
  sfxSource: {fileID: 1763609843}
  attackSFX: {fileID: 8300000, guid: 80408972fd6c9477db7cb1c5b6919696, type: 3}
  enemyAttackSFX: {fileID: 8300000, guid: 41066aa89310f4d05b5a9eaf6f0c41c2, type: 3}
  healSFX: {fileID: 8300000, guid: a956488fad5704da6b89d952e0fa012f, type: 3}
  blockSFX: {fileID: 8300000, guid: d0eb4185efb0b43508bef86ddaa44d27, type: 3}
  blockedImpactSFX: {fileID: 8300000, guid: 306742b1e016746768f83c5ff641d8be, type: 3}
  victorySFX: {fileID: 8300000, guid: d03a0b3bc858d456a9c386915e2a7df1, type: 3}
  defeatSFX: {fileID: 8300000, guid: 41502a717209145f5abf8df1b9d42f0c, type: 3}
  powerStrikeSFX: {fileID: 8300000, guid: d2af4a28a729640ad8f5765f76ab345f, type: 3}
  enemyAppearSFX: {fileID: 8300000, guid: 2c2e5a27622034095bddc1210315f141, type: 3}
  enemyDeathSFX: {fileID: 8300000, guid: 763abf20732fb476cb53763a193ad4f3, type: 3}
  telegraphChance: 0.25
  telegraphDamageMultiplier: 1.8
  telegraphSFX: {fileID: 0}
  resultCinematicPanel: {fileID: 203634761}
  resultCinematicImage: {fileID: 917722493}
  resultCinematicText: {fileID: 251713534}
  victorySlides:
  - image: {fileID: -8787238756055001007, guid: 229c6013daf6aa7439ed7b4fe3250dd8, type: 3}
    text: 'The final blow lands true. The beast collapses into the mud, its roar
      silenced at last.


      [PlayerName] lowers their blade, breathing hard.
      The forest falls quiet for the first time in years.

'
  - image: {fileID: 2058706809549236338, guid: 731e5a05d0721e947ac04f75a4447994, type: 3}
    text: Word will reach the kingdom by morning. But even as peace returns... something
      stirs beyond the horizon.
  defeatSlides:
  - image: {fileID: -8048513154784661654, guid: fc9abbae5aeb1414fad66b66a752909f, type: 3}
    text: "Steel meets flesh - but not the enemy's. [PlayerName] staggers, strength
      failing.\n\nThe beast laughs \u2014 a low, grinding sound. 'Another one falls
      before me. You were never a match.'"
  - image: {fileID: 4092212789895258648, guid: 3e37143274a584543920971094aa0687, type: 3}
    text: Darkness creeps at the edges of sight. This tale ends here... but perhaps
      not forever.
  endlessDefeatSlides:
  - image: {fileID: -5632707634560418529, guid: ec5d0b378fde5f94ebbeac38f49feaf1, type: 3}
    text: 'Wave after wave, [PlayerName] stood unbroken - until finally, even legends
      must yield.


      No shame in this fall. Few have carved so long a path through
      the horde.'
  - image: {fileID: -7194346518086056109, guid: bbab036c2fd8b354893cd8566db4c121, type: 3}
    text: Rest now, hero. Your name will be remembered long after the horde is forgotten
  resultCharDelay: 0.03
  resultHoldAfterTyping: 1.2
  fullBlockChance: 0.3
  attackBonusPerBoss: 2
  maxHPBonusPerBoss: 10
